# ==================== Bot Configuration ====================
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username_here
ADMIN_IDS=123456789,987654321

# ==================== Telegram API Server ====================
# Standard Telegram API (use http://localhost:8081 only with a local Bot API server)
TELEGRAM_API_ROOT_URL=https://api.telegram.org
TELEGRAM_API_IS_LOCAL=false
# Local API token (optional, needed only if running local Telegram API)
TELEGRAM_API_TOKEN=

# ==================== Redis Configuration ====================
# For Render: ${RENDER_REDIS_URL} will be set by Render automatically
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==================== Download Limits ====================
# 512MB for Render - adjust if you have custom deployment
MAX_FILE_SIZE_MB=512
TARGET_SIZE_MB=480

# VIDEO_QUALITY: auto, 1080p, 720p, 480p, 360p, audio-only
VIDEO_QUALITY=720p
AUDIO_ONLY=false

# ==================== Platform Configuration ====================
# Comma-separated proxy URLs (format: http://user:pass@host:port)
YOUTUBE_PROXY=
INSTAGRAM_PROXY=
TWITTER_PROXY=
REDDIT_PROXY=

# Cookie directory (Netscape format. No backslashes in path on Windows)
COOKIES_DIR=C:\Users\Username\.yt-dlp\cookies

# ==================== Storage ====================
# Absolute paths (use /tmp on Render, or custom path on local)
DOWNLOAD_TEMP_DIR=C:\Users\Username\Downloads\ubd_temp
LOG_DIR=C:\Users\Username\Downloads\ubd_logs

# Render: Set to /tmp/ubd or /tmp
TEMP_DIR=/tmp/ubd

# ==================== Health Checks ====================
HEALTH_CHECK_DISK_GB=10
HEALTH_CHECK_INTERVAL_MINUTES=15
HEALTH_CHECK_ENABLED=true

# ==================== Cleanup ====================
AUTO_CLEANUP_MODE=atexit
AUTO_CLEANUP_ENABLED=true
CLEANUP_AFTER_UPLOAD=true
CLEANUP_AFTER_FAILURE=true

# ==================== Sleep Prevention ====================
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL=300
KEEP_ALIVE_TIMEOUT=3600

# ==================== Retry Configuration ====================
MAX_RETRIES=3
INITIAL_BACKOFF=2
MAX_BACKOFF=30

# ==================== Output Options ====================
OUTPUT_IS_INTERACTIVE=false
TRUNCATE_CAPTION=true
CAPTION_MAX_LENGTH=1000
SHOW_METADATA=true

# ==================== Progress ====================
PROGRESS_UPDATE_INTERVAL=5
PROGRESS_FORMAT=short

# ==================== Debug ====================
DEBUG=false
LOG_LEVEL=INFO
MONITOR_MEMORY=false